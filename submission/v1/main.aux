\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {A wall visible in real encodings disappears in predicted rollouts.} A pre-reveal context is followed by futures under recorded actions: the simulator, decoded real JEPA encodings, decoded original JEPA predictions, and one flow-model sample. The JEPA rows use encoder seed 0 and the same fitted decoder. The example is the first stored diagnostic context at wall position $x=45$ among 64 contexts whose recorded futures survive the horizon. The flow sample is a single-checkpoint feasibility reference. A decoding failure on predicted latents can reflect both prediction error and off-distribution read-out; it is not alone proof of information loss.}}{5}{figure.2}\protected@file@percent }
\newlabel{fig:rollouts}{{2}{5}{\textbf {A wall visible in real encodings disappears in predicted rollouts.} A pre-reveal context is followed by futures under recorded actions: the simulator, decoded real JEPA encodings, decoded original JEPA predictions, and one flow-model sample. The JEPA rows use encoder seed 0 and the same fitted decoder. The example is the first stored diagnostic context at wall position $x=45$ among 64 contexts whose recorded futures survive the horizon. The flow sample is a single-checkpoint feasibility reference. A decoding failure on predicted latents can reflect both prediction error and off-distribution read-out; it is not alone proof of information loss}{figure.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces \textbf  {Final gate outcomes, with predictor variants kept separate.} Mean $\pm $ sample standard deviation across policy runs; discovery is final survival above $50\%$. JEPA imagination variants and real-latent conditions each contain $3$ models $\times $ $3$ policies; pixel controls have three policies. Real training changes rewards, terminations, and PPO protocol alongside dynamics. Flow is a single-model reference.}}{5}{table.2}\protected@file@percent }
\newlabel{tab:gate-main}{{2}{5}{\textbf {Final gate outcomes, with predictor variants kept separate.} Mean $\pm $ sample standard deviation across policy runs; discovery is final survival above $50\%$. JEPA imagination variants and real-latent conditions each contain $3$ models $\times $ $3$ policies; pixel controls have three policies. Real training changes rewards, terminations, and PPO protocol alongside dynamics. Flow is a single-model reference}{table.2}{}}
