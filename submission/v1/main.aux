\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Recoverable information can support successful control.} Final real-gate survival for MLP policies on frozen latents or pixels (left), and CNN policies on decoded latents or pixels (right). Points are policy runs, grouped by encoder seed; the dashed line is the $50\%$ discovery criterion. Both decoded-latent discoveries use encoder 1. Reconstruction supervision and CNN training are additional to representation fitting.}}{6}{figure.3}\protected@file@percent }
\newlabel{fig:representation}{{3}{6}{\textbf {Recoverable information can support successful control.} Final real-gate survival for MLP policies on frozen latents or pixels (left), and CNN policies on decoded latents or pixels (right). Points are policy runs, grouped by encoder seed; the dashed line is the $50\%$ discovery criterion. Both decoded-latent discoveries use encoder 1. Reconstruction supervision and CNN training are additional to representation fitting}{figure.3}{}}
