\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces The one-step witness of Proposition\nobreakspace  {}\ref  {prop:regret}. Safe pads are $S = [-2,-1]\cup [1,2]$ and everything else is death. Action $A$ lands in a pad with probability one but its mean, $0$, is in the wall; action $B$ dies with probability one but its mean, $3/2$, is in a pad. Solid arrows are the two equally likely outcomes, the dashed arrow is the squared-error-optimal prediction, and the predictor is correct about both means. This is the gate world in miniature.}}{13}{figure.1}\protected@file@percent }
\newlabel{fig:theory}{{1}{13}{The one-step witness of Proposition~\ref {prop:regret}. Safe pads are $S = [-2,-1]\cup [1,2]$ and everything else is death. Action $A$ lands in a pad with probability one but its mean, $0$, is in the wall; action $B$ dies with probability one but its mean, $3/2$, is in a pad. Solid arrows are the two equally likely outcomes, the dashed arrow is the squared-error-optimal prediction, and the predictor is correct about both means. This is the gate world in miniature}{figure.1}{}}
